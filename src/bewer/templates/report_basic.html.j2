<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default('Speech Recognition Performance Report', true) }}</title>
    <style>
        body {
            font-family: 'Courier New', Consolas, monospace;
            font-size: 14px;
            background-color: {{ base_color_scheme.BG_COLOR }};
            color: {{ base_color_scheme.TEXT_COLOR }};
            min-width: 1000px;
            max-width: 1000px;
            margin: 0 auto;
        }
        body > div,
        body > table {
            display: block;
            overflow-x: auto;
        }
        h1 {
            color: {{ base_color_scheme.TABLE_HEADER_BG }};
            margin: 60px 0px 30px 0px;
            text-align: center;
        }
        .report-metadata {
            text-align: center;
            color: {{ base_color_scheme.DIV_TEXT_COLOR }};
            margin: 0px 0px 30px 0px;
            font-style: italic;
        }
        .kw {
            position: relative;
        }
        .kw::before {
            content: '';
            position: absolute;
            top: -2px;
            bottom: -2px;
            left: 0;
            right: 0;
            border-top: 1px solid #00a2ff;
            border-bottom: 1px solid #00a2ff;
            pointer-events: none;
        }
        .kw-start::before {
            left: -3px;
            border-left: 1px solid #00a2ff;
        }
        .kw-end::before {
            right: -3px;
            border-right: 1px solid #00a2ff;
        }
        .tables-side-by-side {
            display: flex;
            gap: 50px;
        }
        .divider-title {
            font-size: 24px;
            color: {{ base_color_scheme.DIV_TEXT_COLOR }};
            margin: 60px 0px 30px 0px;
        }
        .list-values-container {
            border-radius: 5px;
        }
        .list-values-table {
            background-color: {{ base_color_scheme.DIV_BG_COLOR }};
            border-radius: 5px;
            border-collapse: separate;
            border: 1px solid {{ base_color_scheme.TABLE_HEADER_BG }};
            border-spacing: 0;
            margin-bottom: 15px;
        }
        .list-values-table td,
        .list-values-table th {
            padding: 10px 20px;
        }
        .list-values-table tr.value-row:not(:last-child) td {
            border-bottom: 1px solid #e0e0e0;
        }
        .list-values-table td:first-child,
        .list-values-table tr.value-row th:first-child {
            border-right: 1px solid #e0e0e0;
        }
        .list-values-table th {
            font-weight: normal;
            background-color: {{ base_color_scheme.TABLE_HEADER_BG }};
            color: #ffffff;
        }
        .list-values-table tr:first-child > th[colspan] {
            color: #ffffff;
        }
        .list-values-table th.dataset-name-header {
            color: #cccccc;
        }
        .list-values-table th.dataset-name-header {
            background-color: {{ base_color_scheme.TABLE_HEADER_BG }};
        }
        .list-values-table tr.value-row td:nth-child(2) {
            font-weight: normal;
        }
        .list-values-table tr.value-row:first-child td {
            padding-top: 15px;
        }
        .list-values-table tr.value-row:last-child td {
            padding-bottom: 15px;
        }
        .alignment-gallery {
            overflow: visible;
        }
        .alignment-container {
            border-radius: 5px;
        }
        .alignment-table {
            background-color: {{ base_color_scheme.DIV_BG_COLOR }};
            color: {{ base_color_scheme.DIV_TEXT_COLOR }};
            border-radius: 5px;
            border-collapse: separate;
            border: 1px solid {{ base_color_scheme.TABLE_HEADER_BG }};
            border-spacing: 0;
            margin-bottom: 15px;
            width: 100%;
        }
        .alignment-table-lines {
            text-align: right;
            padding-left: 10px;
        }
        .alignment-table-names {
            text-align: left;
            font-weight: normal;
            padding: 0px 10px;
        }
        .alignment-table th {
            font-weight: normal;
            text-align: left;
            background-color: {{ base_color_scheme.TABLE_HEADER_BG }};
            color: white;
            padding: 10px 10px;
            position: sticky;
            top: 43px;
            z-index: 5;
        }
        .alignment-table th .ds-name-header {
            color: #cccccc;
        }
        .alignment-table tr.alignment-row:nth-child(even) td {
            padding-top: 15px;
            padding-bottom: 5px;
        }
        .alignment-table tr:nth-child(odd) td {
            padding-top: 5px;
            padding-bottom: 15px;
        }
        .legend-container {
            margin-top: 15px;
            margin-bottom: 15px;
            padding: 10px;
            border: 1px solid {{ base_color_scheme.TABLE_HEADER_BG }};
            border-radius: 5px;
            position: sticky;
            top: 0;
            background-color: {{ base_color_scheme.DIV_BG_COLOR }};
            z-index: 10;
        }
        .legend-container-item {
            display: inline-block;
            margin: 0px 10px;
            position: relative;
        }
        .legend-container-item[data-tooltip]:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            background: #333;
            color: #fff;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            min-width: 200px;
            max-width: 400px;
            white-space: normal;
            word-wrap: break-word;
            z-index: 20;
        }
        .icon {
            position: absolute;
            top: 40px;
            left: 80px;
        }
        .icon svg {
            width: 75px;
            height: 75px;
        }
        .icon svg path {
            fill: #00000013;
        }
        .alignment-surface {
            display: none;
        }
        body.surface-view .alignment-normalized {
            display: none;
        }
        body.surface-view .alignment-surface {
            display: table;
        }
        {%- if multi_dataset %}
        {%- for css_name in dataset_css_names %}
        body:not(.dataset-{{ css_name }}) .alignment-dataset-{{ css_name }} {
            display: none;
        }
        {%- endfor %}
        {%- endif %}
        .surface-toggle-box {
            position: fixed;
            top: 0;
            left: calc(50% + 510px);
            z-index: 100;
            border: 1px solid {{ base_color_scheme.TABLE_HEADER_BG }};
            border-radius: 5px;
            overflow: hidden;
        }
        .surface-toggle-box-header {
            background-color: {{ base_color_scheme.TABLE_HEADER_BG }};
            color: #ffffff;
            padding: 8px 15px;
            font-size: 14px;
            font-weight: normal;
        }
        .surface-toggle-box-body {
            background-color: #ffffff;
            padding: 10px 28px;
        }
        .surface-toggle-box label {
            cursor: pointer;
            user-select: none;
            font-size: 13px;
            vertical-align: middle;
            color: #000000;
            display: block;
            text-align: left;
            margin-right: 25px;
        }
        .surface-toggle-box input[type="checkbox"] {
            margin-right: 8px;
            vertical-align: middle;
        }
        .surface-toggle-box input[type="radio"] {
            margin-right: 8px;
            vertical-align: middle;
        }
        .surface-toggle-box .radio-label {
            display: flex;
            align-items: center;
            margin-bottom: 6px;
            position: relative;
        }
        .surface-toggle-box .radio-label input[type="radio"] {
            margin-top: 1px;
        }
        .surface-toggle-box .toggle-divider {
            border-top: 1px solid #e0e0e0;
            margin: 8px 0;
        }
        .surface-toggle-box .toggle-section-label {
            font-size: 11px;
            color: #888;
            margin-bottom: 4px;
        }
     </style>
</head>
<body{% if multi_dataset %} class="dataset-{{ dataset_css_names[0] }}"{% endif %}>

    <h1>{{ title | default('Speech Recognition Performance Report', true) }}</h1>
    <p class="report-metadata">Created: {{ creation_date }}{% for key, value in metadata.items() %} &bull; {{ key }}: {{ value }}{% endfor %}</p>

    <div class="icon">
    {% set icon_svg %}
    {% include 'icons/corti-orb.svg' %}
    {% endset %}
    {{ icon_svg | indent_tabs(2) | safe }}
    </div>

    <div class="divider-title">Summary</div>

    <div class="tables-side-by-side">
{% set metrics_content %}
{% with title="Metrics", values=metrics, multi_dataset=multi_dataset, dataset_names=dataset_names, leftmost_header="Name" %}
{% include 'table_list_values.html.j2' %}
{% endwith %}
{% endset %}
{{ metrics_content | indent_tabs(2) | safe }}


{% set summary_content %}
{% with title="Descriptive Statistics", values=summary, multi_dataset=multi_dataset, dataset_names=dataset_names, leftmost_header="Count" %}
{% include 'table_list_values.html.j2' %}
{% endwith %}
{% endset %}
{{ summary_content | indent_tabs(2) | safe }}
    </div>
    <div class="divider-title">Examples</div>


{% set alignment_gallery -%}
{%- with example_iterator=dataset, alignments=alignments, color_scheme=alignment_color_scheme, labels=alignment_labels, multi_dataset=multi_dataset, dataset_names=dataset_names, dataset_css_names=dataset_css_names -%}
{%- include 'alignment_gallery.html.j2' -%}
{%- endwith -%}
{%- endset -%}
{{- alignment_gallery | indent_tabs(2) | safe }}


    <div class="surface-toggle-box" id="surface-toggle-box">
        <div class="surface-toggle-box-header">Options</div>
        <div class="surface-toggle-box-body">
            <label><input type="checkbox" id="surface-toggle" checked>Normalize</label>
            {%- if multi_dataset %}
            <div class="toggle-divider"></div>
            {%- for ds_name in dataset_names %}
            <label class="radio-label"><input type="radio" name="dataset-toggle" value="{{ ds_name }}"{% if loop.first %} checked{% endif %}>{{ ds_name }}</label>
            {%- endfor %}
            {%- endif %}
        </div>
    </div>

    <script>
        (function() {
            var toggleBox = document.getElementById("surface-toggle-box");
            if (!toggleBox) return;
            var legend = document.querySelector(".legend-container");
            if (!legend) return;

            function positionToggle() {
                var legendRect = legend.getBoundingClientRect();
                if (legendRect.top > 0) {
                    toggleBox.style.top = legendRect.top + "px";
                } else {
                    toggleBox.style.top = "0px";
                }
            }

            window.addEventListener("scroll", positionToggle);
            window.addEventListener("resize", positionToggle);
            positionToggle();

            document.getElementById("surface-toggle")?.addEventListener("change", function() {
                document.body.classList.toggle("surface-view", !this.checked);
            });
            document.body.classList.toggle("surface-view", !document.getElementById("surface-toggle").checked);

            {%- if multi_dataset %}
            var datasetRadios = document.querySelectorAll('input[name="dataset-toggle"]');
            datasetRadios.forEach(function(radio) {
                radio.addEventListener("change", function() {
                    {%- for css_name in dataset_css_names %}
                    document.body.classList.remove("dataset-{{ css_name }}");
                    {%- endfor %}
                    document.body.classList.add("dataset-" + this.value.replace(/[^a-zA-Z0-9_-]/g, "-"));
                });
            });
            {%- endif %}
        })();
    </script>
</body>
</html>
